# Canonical environment-variable example for local/Vercel configuration.
# Keep real values in local/Vercel environment settings; never commit them.

# Public browser/server Supabase configuration.
# These are publishable identifiers, not service-role credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional server aliases. Runtime code can derive the public values from VITE_*,
# but these aliases are accepted by server-side proxy routes when supplied.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Server-only secret. NEVER prefix with VITE_ and never expose it to browser code.
# Define only for server-side functions that explicitly require service-role access.
SUPABASE_SERVICE_ROLE_KEY=
